{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "redis chart values (enum guards)",
  "description": "Partial schema: constrains the values whose typos silently misconfigure Redis. additionalProperties stays open so the rest of values.yaml is unconstrained.",
  "type": "object",
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Kubernetes ResourceRequirements as the charts pass it through: requests and limits only (#271). Closed on purpose -- a typo'd reqests:/limts: used to render a silently resource-less container, and a scalar here (easy with --set or a templated values file) an invalid container spec that only the API server rejected, after the release was already going out. Any further ResourceRequirements field (claims) has to be added here deliberately.",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "resourceList": {
      "type": "object",
      "description": "A resource quantity map. Values are string or number: both quantity spellings (cpu: 1, cpu: \"100m\", memory: 1Gi) must keep working, and the key set stays open so extended resources (nvidia.com/gpu, hugepages-2Mi) are not rejected.",
      "additionalProperties": { "type": ["string", "number"] }
    }
  },
  "properties": {
    "architecture": {
      "enum": ["standalone", "replication"]
    },
    "redis": {
      "type": "object",
      "properties": {
        "resources": { "$ref": "#/definitions/resources" },
        "bootstrap": {
          "type": "object",
          "properties": {
            "resources": { "$ref": "#/definitions/resources" }
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": "string" },
            "size": { "type": "string" },
            "retain": { "type": "boolean" }
          }
        },
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "acl": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "operatorUser": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+$"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.-]+$"
                      },
                      "rules": {
                        "type": "string"
                      },
                      "passwordSecret": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "key": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "maxmemory-policy": {
              "enum": [
                "noeviction",
                "allkeys-lru",
                "allkeys-lfu",
                "allkeys-random",
                "volatile-lru",
                "volatile-lfu",
                "volatile-random",
                "volatile-ttl"
              ]
            },
            "appendfsync": {
              "enum": ["always", "everysec", "no"]
            },
            "min-replicas-to-write": {
              "type": "integer",
              "minimum": 0
            },
            "min-replicas-max-lag": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "sentinel": {
      "type": "object",
      "properties": {
        "resources": { "$ref": "#/definitions/resources" },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
            }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "clientCertAuth": {
          "type": "boolean"
        }
      }
    },
    "exporter": {
      "type": "object",
      "properties": {
        "resources": { "$ref": "#/definitions/resources" },
        "image": {
          "type": "object",
          "properties": {
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
            }
          }
        },
        "connectionTimeout": { "type": "string" },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "logFormat": {
          "enum": ["", "txt", "json"]
        },
        "includeConfigMetrics":   { "type": "boolean" },
        "includeSystemMetrics":   { "type": "boolean" },
        "exportClientList":       { "type": "boolean" },
        "disableExporterMetrics": { "type": "boolean" },
        "extraEnvVars": { "type": "array" },
        "dashboards": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "label": { "type": "string", "minLength": 1 },
            "labelValue": { "type": "string" },
            "namespace": { "type": "string" },
            "additionalLabels": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        }
      }
    }
  }
}
